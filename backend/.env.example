PORT=7000
DB_CONNECTION_STRING=mongodb://localhost:27017/safevoyage
JWT_SECRET=replace_with_32_char_random_string

# Gmail
EMAIL_PROVIDER=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Amazon SES (alternative)
# EMAIL_PROVIDER=ses
# SES_HOST=email-smtp.ap-south-1.amazonaws.com
# SES_PORT=587
# SES_USER=your_ses_user
# SES_PASS=your_ses_pass

ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Logging
LOG_LEVEL=info

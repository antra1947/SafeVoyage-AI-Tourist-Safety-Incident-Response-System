<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>SafeVoyage Live Map</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: sans-serif; background: #1a1a2e; color: #eee; }
    #header { padding: 12px 20px; background: #16213e; display: flex; align-items: center; gap: 12px; }
    #header h1 { font-size: 1.2rem; color: #e94560; }
    #map { height: calc(100vh - 50px); width: 100%; }
  </style>
</head>
<body>
  <div id="header">
    <h1>SafeVoyage Live Map</h1>
    <span id="status" style="font-size:0.85rem; color:#aaa;">Connecting...</span>
  </div>
  <div id="map"></div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const TOKEN = "<%= token %>";
    const CURRENT_USER_ID = "<%= userId %>";
    const POLL_INTERVAL = 7000;

    const map = L.map("map").setView([20, 78], 5);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "© OpenStreetMap contributors",
    }).addTo(map);

    const markers = {};
    let myMarker = null;

    const blueIcon = L.icon({ iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-blue.png", iconSize: [25, 41], iconAnchor: [12, 41] });
    const yellowIcon = L.icon({ iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-gold.png", iconSize: [25, 41], iconAnchor: [12, 41] });

    // Socket connection
    const socket = io({ auth: { token: TOKEN } });
    socket.on("connect", () => { document.getElementById("status").textContent = "Connected"; });
    socket.on("connect_error", (e) => { document.getElementById("status").textContent = "Error: " + e.message; });

    // Send own location
    const sendLocation = (lat, lng) => socket.emit("send-location", { latitude: lat, longitude: lng });

    if (navigator.geolocation) {
      navigator.geolocation.watchPosition(
        ({ coords }) => {
          const { latitude: lat, longitude: lng } = coords;
          sendLocation(lat, lng);
          if (!myMarker) {
            myMarker = L.marker([lat, lng], { icon: blueIcon }).addTo(map).bindPopup("You").openPopup();
            map.setView([lat, lng], 15);
          } else {
            myMarker.setLatLng([lat, lng]);
          }
          pollNearby(lat, lng);
        },
        (err) => console.error(err),
        { enableHighAccuracy: true }
      );
    }

    // Poll nearby users every POLL_INTERVAL ms
    let lastLat, lastLng;
    const pollNearby = (lat, lng) => { lastLat = lat; lastLng = lng; };

    setInterval(async () => {
      if (!lastLat) return;
      try {
        const res = await fetch(`/api/locations/nearby?lat=${lastLat}&lng=${lastLng}&radius=100`, {
          headers: { Authorization: "Bearer " + TOKEN },
        });
        const { data } = await res.json();
        const seen = new Set();
        data.forEach(({ userId, name, coordinates }) => {
          seen.add(userId);
          const [lng, lat] = coordinates;
          if (markers[userId]) {
            markers[userId].setLatLng([lat, lng]);
          } else {
            markers[userId] = L.marker([lat, lng], { icon: yellowIcon }).addTo(map).bindPopup(name);
          }
        });
        // Remove stale markers
        Object.keys(markers).forEach((id) => {
          if (!seen.has(id)) { map.removeLayer(markers[id]); delete markers[id]; }
        });
      } catch (e) { console.error(e); }
    }, POLL_INTERVAL);
  </script>
</body>
</html>
